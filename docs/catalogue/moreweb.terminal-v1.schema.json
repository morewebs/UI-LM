{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morewebs.dev/ui-lm/terminal/v0.9.1",
  "title": "moreweb terminal page, v0.9.1",
  "description": "One screen described as a page. Every key, type and optionality in this file was derived from the corpus - 1,639 pages - not from a single example (rounds 150-151).",
  "type": "object",
  "required": [
    "version",
    "createSurface"
  ],
  "properties": {
    "version": {
      "const": "v0.9.1"
    },
    "createSurface": {
      "type": "object",
      "required": [
        "surfaceId",
        "catalogId",
        "root",
        "components"
      ],
      "properties": {
        "surfaceId": {
          "type": "string",
          "minLength": 1
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string"
        },
        "panes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
